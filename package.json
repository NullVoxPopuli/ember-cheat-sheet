{
  "name": "ember-cheat-sheet",
  "version": "1.0.0",
  "private": true,
  "description": "Cheatsheets for Ember",
  "repository": {
    "type": "git",
    "url": "https://github.com/NullVoxPopuli/ember-cheat-sheet.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#config": "./app/config.ts",
    "#components/*": "./app/components/*",
    "#services/*": "./app/services/*",
    "#test-helpers/*": "./tests/helpers/*",
    "#utils/*": "./app/utils/*"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "vite",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "build:test": "EMBER_ENV=test NODE_ENV=development vite build --mode development",
    "test:ci": "testem ci --port 0",
    "test": "pnpm build:test && percy exec -- pnpm test:ci",
    "lint:types": "tsc --noEmit --runExternalCode",
    "i18n:backfill": "node ./lib/backfill-empty-translations.mjs"
  },
  "dependencies": {
    "@docfy/ember": "^0.14.3",
    "@embroider/macros": "^1.21.3",
    "@embroider/router": "^3.0.6",
    "@glimmer/component": "^2.1.1",
    "decorator-transforms": "^2.4.0",
    "ember-intl": "^9.3.0",
    "ember-page-title": "^9.0.3",
    "ember-source": "~7.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/runtime": "^7.29.10",
    "@docfy/ember-vite": "^0.14.3",
    "@ember-intl/vite": "^2.2.1",
    "@ember/app-tsconfig": "^2.1.0",
    "@ember/test-helpers": "^5.7.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/core": "^4.6.9",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@glint/ember-tsc": "^1.11.6",
    "@glint/template": "^1.9.0",
    "@nullvoxpopuli/ember-vite": "1.3.0",
    "@nullvoxpopuli/eslint-configs": "^7.1.0",
    "@percy/cli": "^1.32.11",
    "@percy/sdk-utils": "^1.32.11",
    "@rollup/plugin-babel": "^7.1.0",
    "@shikijs/rehype": "^4.5.0",
    "@types/qunit": "^2.19.14",
    "@typescript/native": "npm:typescript@^7.1.0-dev.20261012.1",
    "axe-core": "^4.14.0",
    "babel-plugin-debug-macros": "^2.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^9.2.5",
    "ember-a11y-testing": "^8.0.1",
    "ember-content-mapper": "^0.3.1",
    "ember-qunit": "^9.2.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.26.0",
    "qunit-dom": "3.5.0",
    "qunit-theme-ember": "^1.0.0",
    "shiki": "^4.5.0",
    "testem": "3.17.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-ember-ssr": "^0.6.2"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "packageManager": "pnpm@10.34.7"
}
